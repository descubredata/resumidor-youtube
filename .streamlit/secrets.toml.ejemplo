# Plantilla de secretos. NO se sube al repositorio con valores reales.
#
# - En tu computador: copia este archivo como `.streamlit/secrets.toml` y pon tus
#   valores. Ese archivo está en el .gitignore, así que nunca se sube.
# - En Streamlit Community Cloud: pega este mismo contenido en
#   Manage app → Settings → Secrets.

# Llave de la API de Claude. Sin esto la app no puede generar informes.
ANTHROPIC_API_KEY = "sk-ant-..."

# Clave de entrada de la app.
# Si la dejas vacía o borras esta línea, la app queda ABIERTA a cualquiera que tenga el
# enlace, y cada análisis que hagan lo pagas tú. Ponla siempre al publicar.
RESUMIDOR_CLAVE = "una-clave-que-solo-tu-sepas"

# Opcional: modelo a usar. Por defecto claude-sonnet-5.
# RESUMIDOR_MODELO = "claude-sonnet-5"
